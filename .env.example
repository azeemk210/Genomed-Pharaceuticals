# =============================================================================
# Genomed Pharmaceuticals — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` for local development.
# Never commit `.env` or `.env.local` to git version control.

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=genomed_db
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# Administrator Credentials & Security
# -----------------------------------------------------------------------------
# JWT secret must be at least 32 characters long
JWT_SECRET=genomed-pharmaceuticals-jwt-secret-key-32chars-min

# Default Backoffice Admin Login:
# URL: http://localhost:3000/admin (or /admin/login)
ADMIN_EMAIL=admin@genomedpharmaceuticals.com
ADMIN_INITIAL_PASSWORD=Genomed@Admin2026

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# Test keys available at: https://dashboard.razorpay.com/app/keys
# In local dev without keys, mock orders and test payments succeed automatically.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# -----------------------------------------------------------------------------
# Shipping & Order Settings
# -----------------------------------------------------------------------------
SHIPPING_FEE=50
FREE_SHIPPING_THRESHOLD=499

# -----------------------------------------------------------------------------
# SMS / OTP Verification
# -----------------------------------------------------------------------------
# Options: 'mock' | 'fast2sms' | 'msg91'
# If set to 'mock' or if SMS_API_KEY is blank:
# - Test OTP '123456' is always accepted
# - Real OTP codes are printed to your terminal console
SMS_PROVIDER=mock
SMS_API_KEY=

# -----------------------------------------------------------------------------
# SMTP Email Notifications (Optional)
# -----------------------------------------------------------------------------
# Dispatches order confirmations and Delhivery tracking updates.
# If omitted or empty, notifications are safely logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Genomed Pharmaceuticals <orders@genomedpharmaceuticals.com>"
